
import pandas as pd
from sklearn.tree import DecisionTreeClassifier, export_text

data = pd.DataFrame({
    "Outlook": ["Sunny", "Sunny", "Overcast", "Rain",
                "Rain", "Rain", "Overcast", "Sunny",
                "Sunny", "Rain", "Sunny", "Overcast",
                "Overcast", "Rain"],
    "Wind": ["Weak", "Strong", "Weak", "Weak",
             "Weak", "Strong", "Strong", "Weak",
             "Weak", "Weak", "Strong", "Strong",
             "Weak", "Strong"],
    "Play": ["No", "No", "Yes", "Yes", "Yes", "No",
             "Yes", "No", "Yes", "Yes", "Yes",
             "Yes", "Yes", "No"]
})

X = pd.get_dummies(data[["Outlook", "Wind"]])
y = data["Play"]

model = DecisionTreeClassifier(criterion="entropy", random_state=0)
model.fit(X, y)

print("Decision Tree:")
print(export_text(model, feature_names=list(X.columns)))

sample = pd.DataFrame([{"Outlook": "Overcast", "Wind": "Weak"}])
sample = pd.get_dummies(sample).reindex(columns=X.columns, fill_value=0)

print("New Sample Classification:", model.predict(sample)[0])
