import numpy as np
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
from sklearn.preprocessing import PolynomialFeatures
from sklearn.metrics import mean_squared_error

X = np.array([1, 2, 3, 4, 5, 6]).reshape(-1, 1)
y = np.array([1, 4, 9, 16, 25, 36])

# Linear Regression
linear = LinearRegression()
linear.fit(X, y)
p1 = linear.predict(X)

# Polynomial Regression
poly = PolynomialFeatures(degree=2)
X_poly = poly.fit_transform(X)

model = LinearRegression()
model.fit(X_poly, y)
p2 = model.predict(X_poly)

print("Linear Regression Predictions:", p1.round(2))
print("Polynomial Regression Predictions:", p2.round(2))

print("Linear MSE:", round(mean_squared_error(y, p1), 2))
print("Polynomial MSE:", round(mean_squared_error(y, p2), 2))

plt.scatter(X, y, color='blue')
plt.plot(X, p1, label='Linear')
plt.plot(X, p2, label='Polynomial')
plt.legend()
plt.show()
