import numpy as np
from sklearn.mixture import GaussianMixture

X = np.array([
    [1], [2], [3], [4], [5],
    [10], [11], [12], [13], [14]
])

model = GaussianMixture(
    n_components=2,
    random_state=42,
    n_init=5
)

model.fit(X)

labels = model.predict(X)

print("Cluster Labels:")
print(labels)

print("Cluster Means:")
print(np.round(model.means_, 2))

print("Algorithm:", "Expectation Maximization")
