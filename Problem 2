
import csv

with open("training.csv", "r") as f:
    data = list(csv.reader(f))

header = data[0]
examples = data[1:]

n = len(header) - 1
S = ["Ø"] * n
G = [["?"] * n]

def covers(h, x):
    return all(a == "?" or a == b for a, b in zip(h, x))

for row in examples:
    x, label = row[:-1], row[-1]

    if label == "Yes":
        G = [g for g in G if covers(g, x)]

        for i in range(n):
            if S[i] == "Ø":
                S[i] = x[i]
            elif S[i] != x[i]:
                S[i] = "?"

    else:
        new_G = []
        for g in G:
            if covers(g, x):


                for i in range(n):
                    if g[i] == "?":
                        if S[i] != "Ø" and S[i] != x[i]:
                            h = g.copy()
                            h[i] = S[i]
                            if covers(h, x) is False:
                                new_G.append(h)
            else:
                new_G.append(g)

        G = []
        for h in new_G:
            if h not in G:
                G.append(h)

print("Specific Boundary S:", S)
print("General Boundary G:", G)
